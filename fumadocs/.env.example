# Base URL used to resolve OG/social preview images. Set to the preview
# deploy's URL when testing; defaults to the production URL otherwise.
NEXT_PUBLIC_SITE_URL=https://docs.plytix.com

# Umami Cloud analytics (see UMAMI-SETUP.md). The production values are
# committed in .env.production, so builds include them. Set these only to
# override them, for example in .env.local while testing the integration.
# The script renders only when both SRC and WEBSITE_ID are set.
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: where the tracker sends pageviews (data-host-url).
NEXT_PUBLIC_UMAMI_HOST_URL=
