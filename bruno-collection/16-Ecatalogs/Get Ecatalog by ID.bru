meta {
  name: Get Ecatalog by ID
  type: http
  seq: 4
}

get {
  url: {{pim_base_url_v3}}/ecatalogs/6a38f615c3d65a5f868b1a41
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.pdf_active: eq false
}

docs {
  Confirmed live 2026-09-08 and 2026-09-21. Fetches the pre-existing "Plytix Brand
  Portal" ecatalog by id -- read-only fixture, never mutated (no undeclared
  `PATCH`/`DELETE` spot-check attempted here, unlike every create-able resource in
  this project, per the ground rule against mutating pre-existing account data).

  Subpath discovery (`GET .../bogus_xyz`) raw field list: `['id','account_id','name',
  'logo','product_list_id','asset_list_id','output_attributes','assets','settings',
  'is_public','password_required','data_sheet_active','pds_active','pdf_active',
  'quote_active','specification_sheet_active','price_list_active','pds_template_id',
  'price_list_id','specification_sheet_id','pdf_catalog_id','exportable_attributes',
  'password','notification_list','quote_request_output_attributes',
  'notification_active','created','modified']` -- matches the spec's
  `ECatalogCreateInputDto` field names closely, plus output-only fields (`is_public`,
  `assets`, `created`).

  `pdf_active: false` confirms this ecatalog doesn't use the (feature-gated-off) PDF
  catalog integration either.
}

example {
  name: Get Ecatalog by ID - Success (Top-Level Fields Only)
  description: Real response captured 2026-09-21 against the "Plytix Brand Portal" ecatalog. Top-level fields only -- output_attributes (30 columns), assets, and settings are omitted for brevity; they exist and were confirmed in the full live response.

  request: {
    url: {{pim_base_url_v3}}/ecatalogs/6a38f615c3d65a5f868b1a41
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6a38f615c3d65a5f868b1a41",
            "account_id": "6a38f5a5b22478f30bfd755c",
            "name": "Plytix Brand Portal",
            "product_list_id": "6a38f5d8c3d65a5f868b18a1",
            "asset_list_id": "6a38f5d8c3d65a5f868b18a2",
            "pdf_catalog_id": null,
            "is_public": false,
            "password_required": false,
            "data_sheet_active": false,
            "pds_active": false,
            "pdf_active": false,
            "quote_active": false,
            "specification_sheet_active": false,
            "price_list_active": false,
            "notification_active": false,
            "output_attributes": ["... 30 columns (label, type, source_type, formula, formatter, output_label per entry) ..."],
            "assets": ["... uploaded UI assets (logo, background images) ..."],
            "settings": {"... deeply nested theme, header, footer, product_filters, product_page components ... "},
            "created": "2025-02-26T14:45:00.000000",
            "modified": "2026-09-15T00:00:00.000000"
          },
          "errors": []
        }
      '''
    }
  }
}
