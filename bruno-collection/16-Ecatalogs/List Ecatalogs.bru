meta {
  name: List Ecatalogs
  type: http
  seq: 3
}

get {
  url: {{pim_base_url_v3}}/ecatalogs
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.data[0].name: eq Plytix Brand Portal
}

docs {
  Confirmed live 2026-09-08 and 2026-09-21 against "David's Dev Account". `GET` works
  fine despite creation being blocked (see "Create Ecatalog - Feature Not Enabled
  (422).bru") -- this account has one real, pre-existing ecatalog, "Plytix Brand
  Portal" (id `6a38f615c3d65a5f868b1a41`, read-only fixture, never mutated by this
  test).

  ## Real shape confirmed without needing to create anything
  Since creation is blocked, this pre-existing ecatalog is the only source of a real
  `ECatalogOutputDto` shape. Notable confirmed details the spec only lightly describes:
  - `output_attributes`: each entry has `label`, `type`, `source_type`, `labels`
    (array), `formula` (a `"{{ attribute.path }}"` template string or a nested
    `{"CONCAT":[...]}`-style object for computed ones), `formatter` (a similar
    nested-object DSL, e.g. `{"DECIMAL_FORMAT":[...]}`, `{"JOIN":[...]}`,
    `{"RESOLVE_RELATIONSHIPS":[...]}`, `{"HIERARCHY_SEPARATOR":[...]}`), and
    `output_label`.
  - `settings` is a deeply nested object covering `general` (theme/colors/font),
    `header`, `footer`, `product_filters`/`file_filters`, `product_sorting`/
    `file_sorting`, `product_search`/`file_search`, `product_overview`/`file_overview`,
    `product_page` (a `components` array describing page-builder blocks like
    "Attributes grid", "Assets", "Variations", "Relationships"), and
    `attribute_usages`.
  - `assets` is a separate array of uploaded UI assets (logo, background images)
    referenced by `uuid` from `settings`, distinct from PIM assets.
  - Direct `product_list_id`/`asset_list_id`/`pdf_catalog_id` fields all present and
    populated on this real one.
}

example {
  name: 200 - Full Parameters
  description: Real response captured 2026-09-22 against "David's Dev Account", combining sparse _fields, page-number pagination, and _sort_by in one GET /ecatalogs call. Only one ecatalog exists in this account, so pagination.next_page is correctly empty even with _page_size=5.

  request: {
    url: {{pim_base_url_v3}}/ecatalogs?_fields=id&_fields=name&_fields=is_public&_page=1&_page_size=5&_sort_by=name
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "id": "6a38f615c3d65a5f868b1a41",
              "name": "Plytix Brand Portal",
              "is_public": false
            }
          ],
          "errors": [],
          "pagination": {}
        }
      '''
    }
  }
}

example {
  name: 200 - Success (Key Fields Only)
  description: Real response captured 2026-09-21 against "David's Dev Account". One ecatalog exists. Key fields only shown -- the full response object is very large (output_attributes, assets, settings arrays).

  request: {
    url: {{pim_base_url_v3}}/ecatalogs
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "id": "6a38f615c3d65a5f868b1a41",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Plytix Brand Portal",
              "product_list_id": "6a38f5d8c3d65a5f868b18a1",
              "asset_list_id": "6a38f5d8c3d65a5f868b18a2",
              "is_public": false,
              "created": "2025-02-26T14:45:00.000000",
              "modified": "2026-09-15T00:00:00.000000"
            }
          ],
          "errors": [],
          "pagination": {}
        }
      '''
    }
  }
}
