meta {
  name: Update and Delete Channel (Undeclared)
  type: http
  seq: 7
}

delete {
  url: {{pim_base_url_v3}}/channels/REPLACE_WITH_CHANNEL_ID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

docs {
  Confirmed live 2026-09-08 against a throwaway channel, since deleted.
  `openapi_pimv3.json` declares no `PATCH`/`DELETE` for this resource;
  both work anyway (`PATCH` rename -- `200`; `DELETE` -- `204`) -- the
  11th resource confirmed with this pattern this project, out of 11
  tested so far. At this point the pattern should be assumed to
  generalize to essentially every v3 resource unless proven otherwise.
}
