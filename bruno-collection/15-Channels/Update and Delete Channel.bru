example {
  name: 200 - Full Parameters (All Fields)
  description: Real response captured 2026-09-22 against a disposable scratch channel (id 6ab2fec0125f1d0ceeeed6c8, same one from "Create Channel - Full Parameters"), exercising a broad spread of ChannelUpdateInputDto fields in one PATCH -- rename, active toggle, process/parent-include criteria (both main and on-demand), childs_first, and the store_title/store_link/store_description trio (unused elsewhere in this collection). Discovered live that parent_include_criteria/on_demand_parent_include_criteria only accept 'ONLY_PARENT_IN_LIST' or 'ALL_PARENT_IN_VARIANTS' (a 422 on 'ALL_PARENTS' revealed the real enum -- narrower than process_products' 4-value CREATED_OR_MODIFIED/CREATED/MODIFIED/ALL set).

  request: {
    url: {{pim_base_url_v3}}/channels/6ab2fec0125f1d0ceeeed6c8
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Params Channel Renamed",
        "active": false,
        "childs_first": true,
        "process_products": "ALL",
        "parent_include_criteria": "ALL_PARENT_IN_VARIANTS",
        "on_demand_process_products": "ALL",
        "on_demand_parent_include_criteria": "ALL_PARENT_IN_VARIANTS",
        "store_title": "WC Test Store",
        "store_link": "https://example.com/store",
        "store_description": "WC test store description for full-parameter PATCH example"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "active": false,
            "already_processed_through_integrations": true,
