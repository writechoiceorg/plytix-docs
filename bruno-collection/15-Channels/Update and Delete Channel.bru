example {
  name: 204 - Success (Then 404 On Follow-Up GET)
  description: Real response captured 2026-09-15 against the same disposable scratch channel, immediately after the PATCH above.

  request: {
    url: {{pim_base_url_v3}}/channels/6aa982cba30ca5945169a253
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: 404 - After Delete
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above.

  request: {
    url: {{pim_base_url_v3}}/channels/6aa982cba30ca5945169a253
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa982cba30ca5945169a253 not found"
            }
          ]
        }
      '''
    }
  }
}
