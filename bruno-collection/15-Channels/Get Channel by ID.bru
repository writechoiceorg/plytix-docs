meta {
  name: Get Channel by ID
  type: http
  seq: 5
}

get {
  url: {{pim_base_url_v3}}/channels/6aa047d52b6fd055ffb7cadd
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.name: eq WC Test Channel Full
}

docs {
  Confirmed live 2026-09-08. Subpath discovery (`GET .../bogus_xyz`)
  reveals a very large raw field list (`id`, `account_id`, `name`,
  `format`, `product_list_id`, `build_reference_date*`, `active`,
  `output_filename*`, `connections`, `webhook*`, all the
  `rebuild_feed_*` scheduling fields, `columns`, `column_separator`,
  `text_delimiter`, `xml_*`/`product_nodes`, `shopify`, `wayfair`
  (undocumented -- not in the spec's `ChannelCreateInputDto` or output
  DTO), `running`, `file_path`, `last_run_*` fields, `process_products`,
  `parent_include_criteria`, `changes_required`,
  `already_processed_through_integrations`, `processed_user_audit`,
  `store_*`, `created`, `modified`) -- by far the richest resource shape
  in this project so far.
}
