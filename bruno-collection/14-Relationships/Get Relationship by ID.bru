meta {
  name: Get Relationship by ID
  type: http
  seq: 3
}

get {
  url: {{pim_base_url_v3}}/relationships/6a38f5d8c3d65a5f868b186c
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.label: eq related_products
}

docs {
  Confirmed live 2026-09-08 and 2026-09-21. Resolves the exact `relationship_id` named
  in the Phase 2b kept product's `product_relationships` field
  (`6a38f5d8c3d65a5f868b186c`) -- confirms the relationship-id references seen on
  products point to real, fetchable relationship-type resources.

  Subpath discovery raw field list: `['id','account_id','name','label','status',
  'created','modified']` -- matches spec exactly.
}

example {
  name: Get Relationship by ID - Success
  description: Real response captured 2026-09-21 against the "Cross-sell" relationship type (id 6a38f5d8c3d65a5f868b186c).

  request: {
    url: {{pim_base_url_v3}}/relationships/6a38f5d8c3d65a5f868b186c
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6a38f5d8c3d65a5f868b186c",
            "account_id": "6a38f5a5b22478f30bfd755c",
            "name": "Cross-sell",
            "label": "related_products",
            "status": "ACTIVE",
            "created": "2026-06-22T08:44:08.731000",
            "modified": "2026-06-22T08:44:08.731000"
          },
          "errors": []
        }
      '''
    }
  }
}
