meta {
  name: Create Asset - Empty Body (422)
  type: http
  seq: 2
}

post {
  url: {{pim_base_url_v3}}/assets
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 422
  res.body.errors[0].description: contains url
}

docs {
  Confirmed live 2026-09-08 against "David's Dev Account". Trigger case,
  creates nothing.

  `AssetCreateInputDto` marks **no** fields required in
  `openapi_pimv3.json` (`url`, `content`, `filename`, `alt_text`,
  `category_ids`, `static_list_ids` all optional) -- but the live API
  still enforces a real cross-field rule not expressible in the schema's
  `required` list: `{"data":[],"errors":[{"name":
  "InputDTOValidationError","description":"Value error, Either 'url' or
  'content' must be provided"}]}`.
}
