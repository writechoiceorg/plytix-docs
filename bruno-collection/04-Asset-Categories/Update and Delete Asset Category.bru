    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: 404 - Not Found After Delete
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above, confirming a hard delete.

  request: {
    url: {{pim_base_url_v3}}/asset-categories/6aa9819ca30ca5945169a247
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa9819ca30ca5945169a247 not found"
            }
          ]
        }
      '''
    }
  }
}
