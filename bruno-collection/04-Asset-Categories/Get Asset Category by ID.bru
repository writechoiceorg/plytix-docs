meta {
  name: Get Asset Category by ID
  type: http
  seq: 3
}

get {
  url: {{pim_base_url_v3}}/asset-categories/6a9f1b862b6fd055ffb7c7de
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.name: eq WC Test Asset Category
}

docs {
  `GET /api/v3/asset-categories/{id}` -- fetch a single asset category by its
  Mongo ObjectId.

  Confirmed live 2026-09-07. Same shape as `product-categories`'s GET-by-id
  (`id, account_id, name, parent_id, path, slug, order, n_children, created,
  modified`).

  Subpath discovery (`GET .../bogus_xyz`) returns the identical raw field list,
  matching the spec's `AssetCategoryGetOutputDto` exactly -- no undocumented
  fields here either.
}

example {
  name: 200 - Success
  description: Confirmed live 2026-09-21. Full GET-by-id shape for the pre-existing Packshots category; parent_id is null for a root category.

  request: {
    url: {{pim_base_url_v3}}/asset-categories/6a38f5d8c3d65a5f868b1823
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6a38f5d8c3d65a5f868b1823",
            "account_id": "6a38f5a5b22478f30bfd755c",
            "name": "Packshots",
            "parent_id": null,
            "path": ["Packshots"],
            "slug": "packshots",
            "order": 1,
            "n_children": 0,
            "created": "2026-06-22T08:44:08.235000",
            "modified": "2026-06-22T08:44:08.235000"
          },
          "errors": []
        }
      '''
    }
  }
}
