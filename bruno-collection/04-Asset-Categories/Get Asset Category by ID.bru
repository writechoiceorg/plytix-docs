meta {
  name: Get Asset Category by ID
  type: http
  seq: 3
}

get {
  url: {{pim_base_url_v3}}/asset-categories/6a9f1b862b6fd055ffb7c7de
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.name: eq WC Test Asset Category
}

docs {
  Confirmed live 2026-09-07. Same shape as `product-categories`'s GET-by-id
  (`id, account_id, name, parent_id, path, slug, order, n_children,
  created, modified`).

  Subpath discovery (`GET .../bogus_xyz`) returns the identical raw field
  list, matching the spec's `AssetCategoryGetOutputDto` exactly -- no
  undocumented fields here either.
}
