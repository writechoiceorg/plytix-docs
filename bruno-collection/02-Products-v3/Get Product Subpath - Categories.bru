meta {
  name: Get Product Subpath - Categories
  type: http
  seq: 8
}

get {
  url: {{pim_base_url_v3}}/products/6a38f614c3d65a5f868b1a06/categories
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.data[0].name: isString
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account".

  ## What it does
  `GET /products/{id}/categories` -- returns the product's assigned
  categories fully expanded (`id`, `name`, `parent_id`, `path`, `slug`,
  `order`, `n_children`, `modified`), matching `ProductCategoryGetOutputDto`.
  This product (`BAG-10157`) has 2 categories assigned, one from each of
  two taxonomies ("Website Taxonomy" and "Google Shopping Taxonomy" --
  visible in each entry's `path` array).
}
