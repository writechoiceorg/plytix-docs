  }
}

example {
  name: 422 - parent_id + product_family_id Conflict
  description: NEW finding, confirmed live 2026-09-23. Sending parent_id and product_family_id together in the same PATCH fails with a vague, no-field-named error -- same conflict already documented on POST /products create (see "Create Product - Full Featured.bru"'s "201 - Full Parameters (Variant)" example), now confirmed to extend to PATCH too. Omit product_family_id whenever parent_id is present in the same request (a variant inherits family membership from its parent implicitly, so this is rarely a real limitation in practice).

  request: {
    url: {{pim_base_url_v3}}/products/REPLACE_WITH_PRODUCT_ID
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "parent_id": "6ab41478ebb26b08b2285eeb",
        "product_family_id": "6a38f5d8c3d65a5f868b186e"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "product data validation failed"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 403 - UEF Feature Not Enabled (channel_ids/ecatalog_ids)
  description: Confirmed live 2026-09-22, re-verified 2026-09-23. Sending channel_ids, ecatalog_ids, or product_data_sheet_ids in a PATCH body -- individually or together -- fails on this account with a PermissionError never seen elsewhere in this project ("UEF feature is not enabled for this account"). Logged in config/api-testing.config.md's Status-gating rules as a 5th account-level feature gate (joining PDF Catalogs, Ecatalogs, and Automatic Inheritance). NEW as of 2026-09-23: this gate is ATOMIC for the whole request, not just the gated fields -- sending all 12 ProductUpdateInputDto fields together (including 9 perfectly valid ones like label/category_ids/parent_id) still returns a bare 403 with none of the valid fields applied. There is no way to combine a UEF-gated field with any other field in the same call on this account; they must be sent in a separate PATCH once UEF is enabled. Blocks documenting the success shape for assigning a product directly to a channel/ecatalog/data sheet via this field.

  request: {
    url: {{pim_base_url_v3}}/products/REPLACE_WITH_PRODUCT_ID
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "channel_ids": ["6aa047d52b6fd055ffb7cadd"],
        "ecatalog_ids": ["6a38f615c3d65a5f868b1a41"]
      }
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "PermissionError",
              "description": "UEF feature is not enabled for this account"
            }
          ]
        }
      '''
    }
  }
}
