meta {
  name: List Pdf Catalogs
  type: http
  seq: 2
}

get {
  url: {{pim_base_url_v3}}/pdf-catalogs
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  Confirmed live 2026-09-08 against "David's Dev Account". `GET` works
  fine (`200`, empty `data: []` -- this account has zero PDF catalogs).
  See "Create Pdf Catalog - Feature Not Enabled (422).bru" for why none
  can be created here.
}
