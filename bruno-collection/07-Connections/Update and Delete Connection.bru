meta {
  name: Update and Delete Connection
  type: http
  seq: 3
}

delete {
  url: {{pim_base_url_v3}}/connections/REPLACE_WITH_CONNECTION_ID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

docs {
  Confirmed live 2026-09-15 against a fresh disposable scratch FTP
  connection ("WC Test Connection For Patch Delete", id
  `6aa98241a30ca5945169a24d`, created and destroyed in this same run) on
  "David's Dev Account". `DELETE` was previously tested (as "Delete
  Connection (Undeclared)") against a throwaway id with no `example{}`;
  `PATCH` never had a file at all. Both are now formally declared in
  `openapi_pimv3.json`'s 2026-09-15 refresh (previously undeclared but
  working per quirk #20).

  ## What it does
  - `PATCH /connections/{id}` -- `200`, applies a partial update.
    Confirmed `name`, `url`, `port` all apply and round-trip. `type`
    remains the fixed lowercase enum from quirk #21
    (`dropbox`/`ftp`/`sftp`) -- not re-tested for patchability here, but
    worth checking before assuming it can be changed after creation.
  - `DELETE /connections/{id}` -- `204`, then `404` on a follow-up `GET`.
}

example {
  name: 200 - Success
  description: Real response captured 2026-09-15 against a disposable scratch FTP connection on "David's Dev Account".

  request: {
    url: {{pim_base_url_v3}}/connections/6aa98241a30ca5945169a24d
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Connection Renamed",
        "url": "ftp.example.com",
        "port": 21
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "created_at": "2026-09-15T17:37:05.229000+00:00",
            "id": "6aa98241a30ca5945169a24d",
            "last_processed": null,
            "last_result_operation": null,
            "modified": "2026-09-15T17:37:12.598351+00:00",
            "name": "WC Test Connection Renamed",
            "port": 21,
            "source": null,
            "type": "ftp",
            "url": "ftp.example.com",
            "use_tls": false,
            "user": null
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 200 - Full Parameters (FTP)
  description: Confirmed live 2026-09-22 against a disposable scratch FTP connection (created via the "Full Parameters" example in Create Connection.bru, id 6ab2fe65125f1d0ceeeed6ba, deleted after capture). Sets every field ConnectionUpdateInputDto exposes at once (name, url, port, user, password, use_tls). password is write-only, same as on create -- confirmed absent from the PATCH response too.

  request: {
    url: {{pim_base_url_v3}}/connections/6ab2fe65125f1d0ceeeed6ba
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full FTP Connection Renamed",
        "url": "ftp2.example.com",
        "port": 2121,
        "user": "wc_ftp_user_updated",
        "password": "wc_ftp_password_updated",
        "use_tls": false
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "created_at": "2026-09-22T22:17:09.560000+00:00",
            "id": "6ab2fe65125f1d0ceeeed6ba",
            "last_processed": null,
            "last_result_operation": null,
            "modified": "2026-09-22T22:17:21.218143+00:00",
            "name": "WC Test Full FTP Connection Renamed",
            "port": 2121,
            "source": null,
            "type": "ftp",
            "url": "ftp2.example.com",
            "use_tls": false,
            "user": "wc_ftp_user_updated"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 204 - Success
  description: Real response captured 2026-09-15 against the same disposable scratch connection, immediately after the PATCH above.

  request: {
    url: {{pim_base_url_v3}}/connections/6aa98241a30ca5945169a24d
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: 404 - Not Found After Delete
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above.

  request: {
    url: {{pim_base_url_v3}}/connections/6aa98241a30ca5945169a24d
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa98241a30ca5945169a24d not found"
            }
          ]
        }
      '''
    }
  }
}
