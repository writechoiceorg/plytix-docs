meta {
  name: Create Connection
  type: http
  seq: 3
}

post {
  url: {{pim_base_url_v3}}/connections
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test FTP Connection",
    "type": "ftp"
  }
}

assert {
  res.status: eq 201
  res.body.data.type: eq ftp
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account". Created then
  deleted in the same test run (id was `6a9f1cc92b6fd055ffb7c7fe`) --
  Connections has no downstream dependents in `TESTING_PLAN.md`, so this
  scratch resource was cleaned up per the ground rules rather than kept.

  `201 Created`. Response includes several `null`-defaulted FTP-specific
  fields not sent in the request (`url`, `port`, `user`, `source`,
  `last_processed`, `last_result_operation`) plus `use_tls: false`.
}
