example {
  name: 201 - Full Parameters (Dropbox)
  description: Confirmed live 2026-09-22. Populates Dropbox's OAuth-shaped fields (token_type, token, refresh_token, email) with placeholder values -- the API accepts them without validating against a real Dropbox OAuth flow. token_type, token, and refresh_token are all write-only (accepted, never echoed back); only email round-trips. This is the first live confirmation of Dropbox-specific fields in this project -- prior coverage only tested type: "ftp". Scratch resource deleted after capture.

  request: {
    url: {{pim_base_url_v3}}/connections
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Dropbox Connection",
        "type": "dropbox",
        "token_type": "bearer",
        "token": "wc_fake_access_token",
        "refresh_token": "wc_fake_refresh_token",
        "email": "wc-test@example.com"
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fe67125f1d0ceeeed6bc",
            "name": "WC Test Full Dropbox Connection",
            "type": "dropbox",
            "last_processed": null,
            "last_result_operation": null,
            "source": null,
            "email": "wc-test@example.com",
            "modified": "2026-09-22T22:17:11.171664+00:00"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 422 - Invalid Type (Enum Revealed)
  description: Confirmed live 2026-09-07. type is a fixed lowercase enum (dropbox, ftp, sftp) despite the spec describing it as a free string. Uppercase FTP also fails -- case matters.

  request: {
    url: {{pim_base_url_v3}}/connections
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Nonsense Connection",
        "type": "ThisIsNotARealType123"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "InputDTOValidationError",
              "description": "type: Input should be 'dropbox', 'ftp' or 'sftp'"
            }
          ]
        }
      '''
    }
  }
}
