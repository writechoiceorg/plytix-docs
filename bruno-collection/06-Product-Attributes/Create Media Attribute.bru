meta {
  name: Create Media Attribute
  type: http
  seq: 5
}

post {
  url: {{pim_base_url_v3}}/product-attributes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "wc_test_media",
    "type": "MediaAttribute"
  }
}

assert {
  res.status: eq 201
  res.body.data.type: eq MediaAttribute
}

docs {
  Confirmed live 2026-09-07. Created then deleted in the same test run (id
  was `6a9f1bf92b6fd055ffb7c7e5`). `201 Created`, minimal shape -- no
  type-specific optional fields beyond the common
  `name/label/description/group_ids`.
}
