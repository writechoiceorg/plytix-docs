example {
  name: 422 - FormulaAttribute Account Limit Reached
  description: Confirmed live 2026-09-07. Dev account capped at 2 formula attributes (already at limit). Request body is otherwise valid -- the create path for FormulaAttribute itself remains unconfirmed on a fresh account.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_formula",
        "type": "FormulaAttribute",
        "formula_str": "IF(price>0,\"has price\",\"no price\")"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "This account reached the limit of 2 formula attributes"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 422 - Invalid Type (Full Enum Revealed)
  description: Confirmed live 2026-09-07. The pydantic error message is an authoritative list of all 15 valid type tags the live API recognizes -- one more than the 14 in openapi_pimv3.json (HierarchyAttribute is undocumented in the spec).

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_badtype",
        "type": "NotARealType"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "InputDTOValidationError",
              "description": "Input tag 'NotARealType' found using 'type' does not match any of the expected tags: 'TextAttribute', 'MultilineAttribute', 'BooleanAttribute', 'DateAttribute', 'DecimalAttribute', 'DropdownAttribute', 'FormulaAttribute', 'HierarchyAttribute', 'HtmlAttribute', 'IntAttribute', 'MediaAttribute', 'MediaGalleryAttribute', 'MultiSelectAttribute', 'UrlAttribute', 'CompletenessAttribute'"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 500 - HierarchyAttribute Unimplemented (Bug)
  description: Confirmed live 2026-09-07. HierarchyAttribute passes pydantic discriminator validation (it is a recognized type tag) but the create handler is not wired up -- do not build customer-facing docs around this type.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_hierarchy",
        "type": "HierarchyAttribute"
      }
    }
  }

  response: {
    status: {
      code: 500
      text: Internal Server Error
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ConfigurationError",
              "description": "There was an error processing your request. Please try again later"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 201 - Full Parameters (TextAttribute)
  description: Confirmed live 2026-09-22. Every optional common field populated (label, description, group_ids, plus TextAttribute's character_limit). Real finding, resolves config open question #11 -- group_ids DOES link, confirmed via a follow-up GET on the attribute group showing this attribute's label added to attribute_labels. Scratch resource deleted after capture.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_full_text",
        "label": "wc_test_full_text_label",
        "description": "WC full-parameter text attribute example",
        "group_ids": ["6a9f1b872b6fd055ffb7c7df"],
        "type": "TextAttribute",
        "character_limit": 250
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fa0c125f1d0ceeeed6a6",
            "name": "wc_test_full_text",
            "label": "wc_test_full_text_label",
            "description": "WC full-parameter text attribute example",
            "created": "2026-09-22T21:58:36.615000+00:00",
            "modified": "2026-09-22T21:58:36.615000+00:00",
            "type": "TextAttribute",
            "character_limit": 250
          },
          "errors": []
        }
      '''
    }
  }
}

