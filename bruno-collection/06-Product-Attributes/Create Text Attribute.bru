example {
  name: 201 - Full Parameters (DropdownAttribute)
  description: Confirmed live 2026-09-22. Every optional field populated -- label, description, group_ids, options, and all three sorting/restriction booleans explicitly set to non-default values (manual_sorting/sort_ascending false, restricted true). Note the returned options array order does not match input order or a simple alpha sort when manual_sorting is false -- server-side ordering logic, not documented anywhere. Scratch resource deleted after capture.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_full_dropdown",
        "label": "wc_test_full_dropdown_label",
        "description": "WC full-parameter dropdown attribute example",
        "group_ids": ["6a9f1b872b6fd055ffb7c7df"],
        "type": "DropdownAttribute",
        "options": ["Small", "Medium", "Large", "XL"],
        "manual_sorting": false,
        "sort_ascending": false,
        "restricted": true
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fa16125f1d0ceeeed6a9",
            "name": "wc_test_full_dropdown",
            "label": "wc_test_full_dropdown_label",
            "description": "WC full-parameter dropdown attribute example",
            "created": "2026-09-22T21:58:46.734000+00:00",
            "modified": "2026-09-22T21:58:46.734000+00:00",
            "type": "DropdownAttribute",
            "options": ["XL", "Small", "Medium", "Large"],
            "manual_sorting": false,
            "sort_ascending": false,
            "restricted": true
          },
          "errors": []
        }
      '''
    }
  }
}

