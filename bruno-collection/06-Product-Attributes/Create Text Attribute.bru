example {
  name: 422 - FormulaAttribute Full Parameters Request Shape (Account Limit)
  description: Confirmed live 2026-09-22. Documents the full request shape (label, description, group_ids, formula_str) for OpenAPI purposes -- the account limit of 2 formula attributes (already reached) blocks the actual 201 success response from ever being captured on this account. See the account-limit example above for the base case; this one just shows every optional field populated in the request.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_full_formula",
        "label": "wc_test_full_formula_label",
        "description": "WC full-parameter formula attribute example",
        "group_ids": ["6a9f1b872b6fd055ffb7c7df"],
        "type": "FormulaAttribute",
        "formula_str": "CONCAT(sku,\" - \",label)"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "This account reached the limit of 2 formula attributes"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 500 - CompletenessAttribute With Real References (Bug)
  description: Confirmed live 2026-09-08 (reproduced twice). CompletenessAttribute with an empty attributes array creates successfully (201), but providing real attribute references in the correct {id} object shape triggers a 500 -- a live bug blocking any real use of Completeness Attributes.

  request: {
    url: {{pim_base_url_v3}}/product-attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_completeness_real",
        "type": "CompletenessAttribute",
        "attributes": [{"id": "6a9f1bf72b6fd055ffb7c7e1"}]
      }
    }
  }

  response: {
    status: {
      code: 500
      text: Internal Server Error
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ConfigurationError",
              "description": "There was an error processing your request. Please try again later"
            }
          ]
        }
      '''
    }
  }
}
