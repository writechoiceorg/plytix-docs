meta {
  name: Update and Delete Product Attribute
  type: http
  seq: 4
}

delete {
  url: {{pim_base_url_v3}}/product-attributes/REPLACE_WITH_ATTRIBUTE_ID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

docs {
  Confirmed live 2026-09-15 on "David's Dev Account", combining two
  scratch `TextAttribute`s created and destroyed in this same run (`DELETE`
  against `wc_test_patch_delete_attr`, id `6aa981f5a30ca5945169a24a`;
  `PATCH`+`DELETE` against `wc_test_patch_delete_attr2`, id
  `6aa98220a30ca5945169a24c`, since the first attempt's body was rejected
  -- see below). `DELETE` was previously tested (as "Delete Product
  Attribute (Undeclared)") against a throwaway id with no `example{}`;
  `PATCH` never had a file at all. Both are now formally declared in
  `openapi_pimv3.json`'s 2026-09-15 refresh (previously undeclared but
  working per quirk #20).

  ## What it does -- and a real field-name gotcha
  - `PATCH /product-attributes/{id}` accepts `ProductAttributeUpdateInputDto`
    fields: `name`, `description`, `character_limit`, `include_time`,
    `options`, `manual_sorting`, `sort_ascending`, `restricted`,
    `attributes` (completeness), `formula_str` -- a flat superset across
    every attribute type, narrowed server-side per the attribute's
    concrete type. **`label` is explicitly NOT patchable** despite being
    the field GET responses surface most prominently -- sending
    `{"label": "..."}` 422s: `{"errors":[{"name":"InputDTOValidationError",
    "description":"label: Extra inputs are not permitted"}]}`. Use `name`
    instead (confirmed: renaming via `name` updates both `name` and the
    slugified `label` is NOT auto-updated -- `label` stays whatever it was
    set to at creation). `group_ids`/`product_family_ids` are also
    intentionally not patchable per the spec's own DTO description
    (family-attribute membership is a separate async operation, and
    v1 never supported patching `label`/groups here).
  - `DELETE /product-attributes/{id}` -- `204`, then `404` on a follow-up
    `GET` -- genuinely deleted, same pattern as every other resource.
}

example {
  name: Update Product Attribute - Rejected (label is not patchable, 422)
  description: Real response captured 2026-09-15 -- documents the label-vs-name gotcha above.

  request: {
    url: {{pim_base_url_v3}}/product-attributes/6aa981f5a30ca5945169a24a
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "label": "WC Test Patch Delete Attr Renamed"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "InputDTOValidationError",
              "description": "label: Extra inputs are not permitted"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Update Product Attribute - Success (PATCH via name/description/character_limit)
  description: Real response captured 2026-09-15 against a second disposable scratch text attribute, using the correct patchable fields.

  request: {
    url: {{pim_base_url_v3}}/product-attributes/6aa98220a30ca5945169a24c
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "wc_test_patch_delete_attr2_renamed",
        "description": "WC test description",
        "character_limit": 100
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "character_limit": 100,
            "created": "2026-09-15T17:36:32.819000+00:00",
            "created_at": "2026-09-15T17:36:32.819000+00:00",
            "created_user_audit": {
              "type": "USER",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "description": "WC test description",
            "filter_type": "TextAttribute",
            "id": "6aa98220a30ca5945169a24c",
            "label": "wc_test_patch_delete_attr2",
            "modified": "2026-09-15T17:36:40.019409+00:00",
            "modified_user_audit": {
              "type": "API",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "name": "wc_test_patch_delete_attr2_renamed",
            "type": "TextAttribute"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: Delete Product Attribute - Success (204, then 404 on follow-up GET)
  description: Real response captured 2026-09-15 against the same disposable scratch attribute, immediately after the PATCH above.

  request: {
    url: {{pim_base_url_v3}}/product-attributes/6aa98220a30ca5945169a24c
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: Get Product Attribute by ID - After Delete (404)
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above.

  request: {
    url: {{pim_base_url_v3}}/product-attributes/6aa98220a30ca5945169a24c
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa98220a30ca5945169a24c not found"
            }
          ]
        }
      '''
    }
  }
}
