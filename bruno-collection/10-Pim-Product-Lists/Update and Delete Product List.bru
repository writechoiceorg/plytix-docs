meta {
  name: Update and Delete Product List
  type: http
  seq: 4
}

delete {
  url: {{pim_base_url_v3}}/pim-product-lists/REPLACE_WITH_LIST_ID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

docs {
  Confirmed live 2026-09-15 against a fresh disposable scratch static
  list ("WC Test List For Patch Delete", id `6aa9827ea30ca5945169a251`,
  created and destroyed in this same run) on "David's Dev Account" --
  retested from scratch since the original version of this file (named
  "... (Undeclared)") pointed at a throwaway id from 2026-09-08 with no
  `example{}`. `openapi_pimv3.json`'s 2026-09-15 refresh now formally
  declares `PATCH`/`DELETE` for `/pim-product-lists/{identifier}`
  (previously undeclared but working, quirk #20/#35).

  ## What it does
  - `PATCH /pim-product-lists/{id}` with `{"name": "..."}` -- `200`,
    renames the list. Response is the full list shape, including the
    auto-generated `query` for a `Static` list (quirk #34 -- unchanged by
    this rename).
  - `DELETE /pim-product-lists/{id}` -- `204`, then `404` on a follow-up
    `GET`.
}

example {
  name: 200 - Success
  description: Real response captured 2026-09-15 against a disposable scratch static product list on "David's Dev Account".

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists/6aa9827ea30ca5945169a251
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test List Renamed"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "created_user_audit": {
              "type": "API",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "id": "6aa9827ea30ca5945169a251",
            "modified": "2026-09-15T17:38:14.953731+00:00",
            "modified_user_audit": {
              "type": "API",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "name": "WC Test List Renamed",
            "relationship_filters": [],
            "type": "Static",
            "query": [
              [
                {
                  "field": "static_lists",
                  "field_type": "PimProductAttribute.ObjectIdAttribute",
                  "operator": "in",
                  "value": ["6aa9827ea30ca5945169a251"]
                }
              ]
            ],
            "created": "2026-09-15T17:38:06.457000+00:00",
            "account_id": "6a38f5a5b22478f30bfd755c"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 200 - Full Parameters (Rename + Query Replace)
  description: Confirmed live 2026-09-22 against the same scratch Smart list created in "Create Static Product List.bru"'s full-parameters example (id 6ab2fa2c125f1d0ceeeed6b4, deleted after capture). ProductListUpdateInputDto's query field is a SET-replace, not a merge -- this example renames the list and fully replaces its query with a new single-condition filter using the in operator (a multi-value array).

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists/6ab2fa2c125f1d0ceeeed6b4
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Params Smart List Renamed",
        "query": [
          [
            {"operator": "in", "field": "status", "value": ["Completed", "Draft"]}
          ]
        ]
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "created_user_audit": {
              "type": "API",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "id": "6ab2fa2c125f1d0ceeeed6b4",
            "modified": "2026-09-22T22:17:01.312213+00:00",
            "modified_user_audit": {
              "type": "API",
              "user_email": "TestDH",
              "user_id": "6a96a370a3fb0431c692820d"
            },
            "name": "WC Test Full Params Smart List Renamed",
            "relationship_filters": [[]],
            "type": "Smart",
            "query": [
              [
                {"field": "status", "field_type": null, "operator": "in", "value": ["Completed", "Draft"]}
              ]
            ],
            "created": "2026-09-22T21:59:08.221000+00:00",
            "account_id": "6a38f5a5b22478f30bfd755c"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 204 - Success
  description: Real response captured 2026-09-15 against the same disposable scratch list, immediately after the PATCH above.

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists/6aa9827ea30ca5945169a251
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: 404 - Not Found After Delete
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above.

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists/6aa9827ea30ca5945169a251
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa9827ea30ca5945169a251 not found"
            }
          ]
        }
      '''
    }
  }
}
