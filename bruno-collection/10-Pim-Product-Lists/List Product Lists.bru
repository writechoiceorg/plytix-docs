meta {
  name: List Product Lists
  type: http
  seq: 6
}

get {
  url: {{pim_base_url_v3}}/pim-product-lists?_fields=id&_fields=name&_fields=query&_page=1&_page_size=10&_sort_by=name
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  `GET /api/v3/pim-product-lists` — search/page through product lists.
  Confirmed live 2026-09-22 against "David's Dev Account". No dedicated
  `.bru` file previously existed for this collection endpoint (only
  `GET .../{identifier}` was covered) — added to close that gap and give
  a maximal-parameter reference example.

  ## _fields validity is narrower than the full resource shape
  `_fields=type` (a real field, present on every `GET .../{identifier}`
  response) is **rejected** on the search endpoint:
  `400 {"errors":[{"name":"ValueError","description":"Unknown field(s) in
  _fields: type. Valid fields: _created_at, _id, account_id, created,
  created_user_audit, id, modified, modified_user_audit, name, query,
  revision_id"}]}`. This is a new instance of the same
  narrower-searchable-field-set pattern seen elsewhere in this project
  (e.g. quirk #12's `_fields=category_ids` on products) — the *search*
  endpoint's valid `_fields` set doesn't always match the full resource's
  declared/observed field list. `revision_id` is accepted without error
  but is silently absent from the response even when requested — same
  silent-drop pattern as quirk #13/#25/#26.

  ## Confirmed working query params (maximal combination)
  `_fields` (repeatable, see caveat above), `_page`+`_page_size`,
  `_sort_by`, and a plain/operator filter on `name` (e.g.
  `name[icontains]=<substr>`) — all combine correctly in a single request,
  same pattern as `02-Products-v3/List Products.bru`.
}

example {
  name: 200 - Full Parameters
  description: Confirmed live 2026-09-22. Combines every confirmed-working query param in one request against real account data (Accessories/All Products/Amazon Ready lists). revision_id was requested in _fields but is silently absent from the response.

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists?_fields=id&_fields=account_id&_fields=name&_fields=query&_fields=created&_fields=modified&_fields=revision_id&_page=1&_page_size=3&_sort_by=name&name[icontains]=a
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "id": "6a38f613c3d65a5f868b19fd",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Accessories",
              "query": [[]],
              "created": "2026-06-22T08:45:07.916000",
              "modified": "2026-06-22T08:45:12.582000"
            },
            {
              "id": "6a38f613c3d65a5f868b19fe",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "All Products",
              "query": [[{"operator": "in", "field": "static_lists", "value": ["6a38f613c3d65a5f868b19fe"], "field_type": "PimProductAttribute.ObjectIdAttribute"}]],
              "created": "2026-06-22T08:45:07.936000",
              "modified": "2026-06-22T08:45:07.948000"
            },
            {
              "id": "6a38f613c3d65a5f868b1a02",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Amazon Ready",
              "query": [[{"operator": "eq", "field": "attributes.amazon_ready", "value": 100, "field_type": null}]],
              "created": "2026-06-22T08:45:07.997000",
              "modified": "2026-06-22T08:45:12.605000"
            }
          ],
          "errors": [],
          "pagination": {
            "next_page": "http://pim.dev.plytix.com/api/v3/pim-product-lists?_fields=id&_fields=account_id&_fields=name&_fields=query&_fields=created&_fields=modified&_fields=revision_id&_page=2&_page_size=3&_sort_by=name&name%5Bicontains%5D=a"
          }
        }
      '''
    }
  }
}

example {
  name: 400 - Invalid _fields (type)
  description: Confirmed live 2026-09-22. type is a real, returned field on GET .../{identifier} but is NOT a valid _fields value on the search endpoint — narrower searchable-field-set pattern (see quirk log).

  request: {
    url: {{pim_base_url_v3}}/pim-product-lists?_fields=id&_fields=type
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValueError",
              "description": "Unknown field(s) in _fields: type. Valid fields: _created_at, _id, account_id, created, created_user_audit, id, modified, modified_user_audit, name, query, revision_id"
            }
          ]
        }
      '''
    }
  }
}
