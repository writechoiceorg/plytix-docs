meta {
  name: Create Smart Product List
  type: http
  seq: 3
}

post {
  url: {{pim_base_url_v3}}/pim-product-lists
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Smart List",
    "type": "Smart",
    "query": [[{"operator": "eq", "field": "sku", "value": "WC-TEST-FULL-001"}]]
  }
}

assert {
  res.status: eq 201
  res.body.data.type: eq Smart
}

docs {
  Confirmed live 2026-09-08. **Fixture kept** -- id
  `6aa0322d2b6fd055ffb7cabb`, for Phase 4 via `product_list_id`.

  `201 Created`. `query` is a nested array-of-arrays of filter objects
  (`operator`/`field`/`value`/`field_type`) -- matches
  `ProductRelationshipAggregationFilterModel`/`FilterModel`'s shape in
  the spec. Filters directly on `sku`, matching the kept product from
  Phase 2b (`WC-TEST-FULL-001`) -- confirmed via a follow-up `GET
  /products?...` search using the same filter dialect from Phase 0.

  Not idempotent to re-run once the fixture exists -- same `422`
  duplicate-name behavior as "Create Static Product List.bru".
}
