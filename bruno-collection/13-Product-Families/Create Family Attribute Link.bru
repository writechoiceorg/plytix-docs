meta {
  name: Create Family Attribute Link
  type: http
  seq: 7
}

post {
  url: {{pim_base_url_v3}}/product-families/REPLACE_WITH_FAMILY_ID/attributes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "attribute_id": "REPLACE_WITH_ATTRIBUTE_ID",
    "level": "no_level"
  }
}

assert {
  res.status: eq 201
  res.body.data.attribute_id: isString
}

docs {
  Confirmed live 2026-09-15 against a disposable scratch product family
  ("WC Test Product Family", id `6aa97212a30ca5945169a21e`, later
  renamed and deleted -- see "Update and Delete Product Family.bru") and
  the Phase 1 kept text-attribute fixture (`wc_test_text`, id
  `6a9f1bf72b6fd055ffb7c7e1`) on "David's Dev Account". Brand-new
  endpoint in the 2026-09-15 `openapi_pimv3.json` refresh -- links an
  existing attribute to a product family.

  ## Discovering the body shape
  The spec declares no request schema at all for this operation (`{}`).
  An empty `{}` body 422s naming the real DTO:
  `{"errors":[{"name":"ValidationError","description":"1 validation error
  for FamilyAttributeLinkInputDto\\nattribute_id\\n  Field required
  [...]"}]}` -- revealing both the DTO name (`FamilyAttributeLinkInputDto`,
  undocumented in the spec) and the required field (`attribute_id`).
  `level` is optional (one of `"parent_level"`/`"no_level"`/`"variant_level"`
  presumably, mirroring `ProductFamilyCreateInputDto`'s
  `attributes`/`parent_attributes`/`variant_attributes` split -- only
  `"no_level"` was exercised live in this session).

  ## Status code
  `201 Created` -- matches this project's general convention for creates
  (quirk #19), though the spec itself only declares a bare `200` for this
  operation.

  ## Related finding -- PATCH on the identity endpoint is gated
  Once linked, attempting `PATCH /product-families/{id}/attributes/{attribute_id}`
  to change `level` returned `403 {"errors":[{"name":"PermissionError",
  "description":"Automatic inheritance is not available for this
  account"}]}` -- a genuine account-level feature gate distinct from the
  usual validation-error shapes, not previously seen in this project. See
  "Update Family Attribute Level.bru".
}

example {
  name: Create Family Attribute Link - Missing attribute_id (422)
  description: Real response captured 2026-09-15, revealing the DTO name and required field.

  request: {
    url: {{pim_base_url_v3}}/product-families/6aa97212a30ca5945169a21e/attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "1 validation error for FamilyAttributeLinkInputDto\nattribute_id\n  Field required [type=missing, input_value={}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/missing"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Create Family Attribute Link - Success
  description: Real response captured 2026-09-15, linking the Phase 1 kept text-attribute fixture to a disposable scratch product family.

  request: {
    url: {{pim_base_url_v3}}/product-families/6aa97212a30ca5945169a21e/attributes
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "attribute_id": "6a9f1bf72b6fd055ffb7c7e1",
        "level": "no_level"
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "account_id": "6a38f5a5b22478f30bfd755c",
            "product_family_id": "6aa97212a30ca5945169a21e",
            "attribute_id": "6a9f1bf72b6fd055ffb7c7e1",
            "level": "no_level"
          },
          "errors": []
        }
      '''
    }
  }
}
