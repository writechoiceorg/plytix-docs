example {
  name: POST on Generic Subpath - Not Allowed (405, Spec Mismatch)
  description: Real response captured 2026-09-15 -- the spec declares POST as valid on this path but it 405s for every path tried.

  request: {
    url: {{pim_base_url_v3}}/product-families/6aa97212a30ca5945169a21e/name
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      "WC Test Family Via Subpath POST"
    }
  }

  response: {
    status: {
      code: 405
      text: Method Not Allowed
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "MethodNotAllowed",
              "description": "POST is not allowed on this path."
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Delete Product Family - Success (204, then 404 on follow-up GET)
  description: Real response captured 2026-09-15, cleaning up the disposable scratch family used across this session's Product Families testing.

  request: {
    url: {{pim_base_url_v3}}/product-families/6aa97212a30ca5945169a21e
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: Get Product Family by ID - After Delete (404)
  description: Real response captured 2026-09-15, follow-up GET immediately after the DELETE above.

  request: {
    url: {{pim_base_url_v3}}/product-families/6aa97212a30ca5945169a21e
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa97212a30ca5945169a21e not found"
            }
          ]
        }
      '''
    }
  }
}
