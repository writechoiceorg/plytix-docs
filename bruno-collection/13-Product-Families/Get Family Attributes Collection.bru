meta {
  name: Get Family Attributes Collection
  type: http
  seq: 6
}

get {
  url: {{pim_base_url_v3}}/product-families/6a38f5d8c3d65a5f868b186e/attributes
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  Confirmed live 2026-09-15 against the real pre-existing "Accessories"
  product family (id `6a38f5d8c3d65a5f868b186e`) on "David's Dev Account"
  -- read-only `GET`, safe against real data. New in the 2026-09-15
  `openapi_pimv3.json` refresh: `GET /product-families/{product_family_id}/attributes`
  lists every attribute currently linked to that family, scoped
  automatically by the path's `product_family_id` (unlike the top-level
  `GET /family-attributes`, this nested collection endpoint is correctly
  scoped -- no cross-tenant leak observed here).

  ## Key fields
  Same flat shape as the top-level endpoint: `account_id`, `level`,
  `product_family_id`, `attribute_id` per entry. No pagination wrapper
  observed on this nested collection (25 entries returned in one page for
  "Accessories" with no `next_page`).

  The spec (`openapi_pimv3.json`) declares this operation's response
  schema as a bare empty `{}` -- no output DTO reference at all, unlike
  almost every other list endpoint in the spec. Treat the shape confirmed
  here as ground truth over the spec.
}

example {
  name: Get Family Attributes Collection - Success
  description: Real response captured 2026-09-15 against the real "Accessories" product family, trimmed to the first 5 of 25 entries for brevity (full response has no pagination and returns all 25).

  request: {
    url: {{pim_base_url_v3}}/product-families/6a38f5d8c3d65a5f868b186e/attributes
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {"account_id": "6a38f5a5b22478f30bfd755c", "level": "no_level", "product_family_id": "6a38f5d8c3d65a5f868b186e", "attribute_id": "6a38f613c3d65a5f868b19b1"},
            {"account_id": "6a38f5a5b22478f30bfd755c", "level": "parent_level", "product_family_id": "6a38f5d8c3d65a5f868b186e", "attribute_id": "6a38f613c3d65a5f868b19b2"},
            {"account_id": "6a38f5a5b22478f30bfd755c", "level": "parent_level", "product_family_id": "6a38f5d8c3d65a5f868b186e", "attribute_id": "6a38f613c3d65a5f868b19b3"},
            {"account_id": "6a38f5a5b22478f30bfd755c", "level": "parent_level", "product_family_id": "6a38f5d8c3d65a5f868b186e", "attribute_id": "6a38f613c3d65a5f868b19b4"},
            {"account_id": "6a38f5a5b22478f30bfd755c", "level": "parent_level", "product_family_id": "6a38f5d8c3d65a5f868b186e", "attribute_id": "6a38f613c3d65a5f868b19b8"}
          ],
          "errors": []
        }
      '''
    }
  }
}
