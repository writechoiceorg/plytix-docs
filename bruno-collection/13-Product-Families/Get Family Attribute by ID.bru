meta {
  name: Get Family Attribute by ID
  type: http
  seq: 8
}

get {
  url: {{pim_base_url_v3}}/product-families/6a38f5d8c3d65a5f868b186e/attributes/6a38f613c3d65a5f868b19d1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.attribute_id: eq 6a38f613c3d65a5f868b19d1
}

docs {
  Confirmed live 2026-09-15 against the real pre-existing "Accessories"
  product family and one of its real attributes, on "David's Dev
  Account" -- read-only `GET`, safe against real data. Fetches a single
  family<->attribute link record by both path segments.

  ## Subpath discovery (technique reused from Phase 0)
  `GET /product-families/{id}/bogus_xyz` (on the root family resource,
  not this attributes sub-resource) -- `400
  {"errors":[{"name":"ValueError","description":"Field 'bogus_xyz' not
  found. Available fields: ['id','account_id','name','total_products',
  'total_attributes','total_models','created','modified']"}]}` -- matches
  `ProductFamilyOutputDto` exactly, no undocumented internal fields (same
  clean pattern as `product-categories`/`relationships`, unlike
  products/assets).
}

example {
  name: Get Family Attribute by ID - Success
  description: Real response captured 2026-09-15 against a real pre-existing family<->attribute link.

  request: {
    url: {{pim_base_url_v3}}/product-families/6a38f5d8c3d65a5f868b186e/attributes/6a38f613c3d65a5f868b19d1
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "account_id": "6a38f5a5b22478f30bfd755c",
            "level": "parent_level",
            "product_family_id": "6a38f5d8c3d65a5f868b186e",
            "attribute_id": "6a38f613c3d65a5f868b19d1"
          },
          "errors": []
        }
      '''
    }
  }
}
