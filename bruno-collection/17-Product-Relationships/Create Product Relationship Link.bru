meta {
  name: Create Product Relationship Link
  type: http
  seq: 5
}

post {
  url: {{pim_base_url_v3}}/products/REPLACE_WITH_PRODUCT_ID/relationships
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "relationship_id": "REPLACE_WITH_RELATIONSHIP_ID",
    "related_products": [
      { "product_id": "REPLACE_WITH_RELATED_PRODUCT_ID" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data.relationship_id: isString
}

docs {
  Confirmed live 2026-09-15 against two disposable scratch products
  ("WC-TEST-REL-A" id `6aa97b2ca30ca5945169a23f` as the linking product,
  "WC-TEST-REL-B" id `6aa97b2da30ca5945169a240` as the related product)
  and a disposable scratch relationship type (id
  `6aa97b2ca30ca5945169a23e`) on "David's Dev Account". Links one or more
  related products to the given product under a specific relationship
  type -- the write-capable counterpart to the read-only
  `product_relationships` field/`.../relationships` subpath from Phase 0.

  ## Discovering the body shape
  The spec declares no request schema for this operation (`{}`). Two
  rounds of 422s revealed the real `ProductRelationshipLinkInputDto`:
  an empty `{}` body names both top-level required fields
  (`relationship_id`, `related_products`); passing
  `related_products: [{"id": "..."}]` (a natural guess) is rejected with
  `related_products.0.product_id: Field required` AND
  `related_products.0.id: Extra inputs are not permitted` in the same
  response -- revealing the correct nested field name is
  `related_products[].product_id`, not `id`.

  ## Success shape
  `201 Created`. Response nests the newly-created link's
  `related_products` array with **both** `related_product_id` and
  `quantity`/`last_modified` per entry -- `quantity` defaults to `1` when
  not specified. This is notably richer than the plain product GET's
  embedded `product_relationships` field, which is **missing
  `related_product_id` entirely** (see "Get Product Relationships
  Collection.bru"'s docs and the bug noted in
  `config/api-testing.config.md`) -- use this dedicated endpoint's own
  responses (or `GET /related-products?product_id=...`, not the broken
  `.../related-products` subpath) when you need to know *which* product
  is on the other end of a link.
}

example {
  name: Create Product Relationship Link - Missing Fields (422)
  description: Real response captured 2026-09-15, first attempt with an empty body -- reveals both required top-level fields.

  request: {
    url: {{pim_base_url_v3}}/products/6aa97b2ca30ca5945169a23f/relationships
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "2 validation errors for ProductRelationshipLinkInputDto\nrelationship_id\n  Field required [type=missing, input_value={}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/missing\nrelated_products\n  Field required [type=missing, input_value={}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/missing"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Create Product Relationship Link - Wrong Nested Field Name (422)
  description: Real response captured 2026-09-15, second attempt using "id" instead of "product_id" in related_products -- reveals the correct nested field name.

  request: {
    url: {{pim_base_url_v3}}/products/6aa97b2ca30ca5945169a23f/relationships
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "relationship_id": "6aa97b2ca30ca5945169a23e",
        "related_products": [
          { "id": "6aa97b2da30ca5945169a240" }
        ]
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "ValidationError",
              "description": "2 validation errors for ProductRelationshipLinkInputDto\nrelated_products.0.product_id\n  Field required [type=missing, input_value={'id': '6aa97b2da30ca5945169a240'}, input_type=dict]\n    For further information visit https://errors.pydantic.dev/2.13/v/missing\nrelated_products.0.id\n  Extra inputs are not permitted [type=extra_forbidden, input_value='6aa97b2da30ca5945169a240', input_type=str]\n    For further information visit https://errors.pydantic.dev/2.13/v/extra_forbidden"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Create Product Relationship Link - Success
  description: Real response captured 2026-09-15, using the correct field name discovered above.

  request: {
    url: {{pim_base_url_v3}}/products/6aa97b2ca30ca5945169a23f/relationships
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "relationship_id": "6aa97b2ca30ca5945169a23e",
        "related_products": [
          { "product_id": "6aa97b2da30ca5945169a240" }
        ]
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "relationship_id": "6aa97b2ca30ca5945169a23e",
            "relationship_label": "wc_test_product_relationship",
            "related_products": [
              {
                "related_product_id": "6aa97b2da30ca5945169a240",
                "quantity": 1,
                "last_modified": "2026-09-15T17:17:08.594000+00:00"
              }
            ],
            "product_id": "6aa97b2ca30ca5945169a23f"
          },
          "errors": []
        }
      '''
    }
  }
}
