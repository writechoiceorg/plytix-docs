meta {
  name: Update Product Relationship (Quantity)
  type: http
  seq: 7
}

patch {
  url: {{pim_base_url_v3}}/products/REPLACE_WITH_PRODUCT_ID/relationships/REPLACE_WITH_RELATIONSHIP_ID
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "related_products": [
      { "product_id": "REPLACE_WITH_RELATED_PRODUCT_ID", "quantity": 5 }
    ]
  }
}

assert {
  res.status: eq 200
}

docs {
  Confirmed live 2026-09-15 against the same disposable scratch products
  and relationship type as "Create Product Relationship Link.bru" on
  "David's Dev Account".

  ## What it does
  Updates the `quantity` on an existing related-product link (the same
  `related_products[].product_id` shape as the `POST`). Bumping
  `quantity` from its default `1` to `5` on the same
  product-A-to-product-B link confirmed `200` with the new value applied.

  ## Notable response shape difference vs. GET/POST
  Unlike the flat `GET`/collection view (no `related_product_id`
  anywhere), this `PATCH` response's `related_products` entries **do**
  include both `product_id` and `related_product_id` (identical value,
  oddly duplicated under two different key names in the same object) --
  confirming the identifying data genuinely exists server-side and is
  just missing from some of this resource's other response shapes (the
  `GET`s in this folder, and the plain product's own `product_relationships`
  field -- see `config/api-testing.config.md`'s new quirk).
}

example {
  name: Update Product Relationship Quantity - Success
  description: Real response captured 2026-09-15, bumping quantity from 1 to 5 on the link created earlier in this session.

  request: {
    url: {{pim_base_url_v3}}/products/6aa97b2ca30ca5945169a23f/relationships/6aa97b2ca30ca5945169a23e
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "related_products": [
          { "product_id": "6aa97b2da30ca5945169a240", "quantity": 5 }
        ]
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "product_id": "6aa97b2ca30ca5945169a23f",
            "related_products": [
              {
                "last_modified": "2026-09-15T17:32:34.184000+00:00",
                "product_id": "6aa97b2da30ca5945169a240",
                "quantity": 5,
                "related_product_id": "6aa97b2da30ca5945169a240"
              }
            ],
            "relationship_id": "6aa97b2ca30ca5945169a23e",
            "relationship_label": "wc_test_product_relationship"
          },
          "errors": []
        }
      '''
    }
  }
}
