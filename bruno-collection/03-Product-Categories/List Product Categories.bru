meta {
  name: List Product Categories
  type: http
  seq: 2
}

get {
  url: {{pim_base_url_v3}}/product-categories?_page_size=3
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  `GET /api/v3/product-categories` -- list all product categories for the account.

  Confirmed live 2026-09-07 against "David's Dev Account". `_fields` and
  `_page_size` both work (same query-param behavior confirmed for `/products`
  in Phase 0). Account already has real pre-existing categories (e.g.
  "Electronics", "General Office Supplies", "Outerwear") -- read-only fixtures,
  not created by this test.

  Pagination follows the same `pagination.next_page` cursor pattern as
  `/products` -- a full URL when more pages exist, null when exhausted.
}

example {
  name: 200 - Success (Paginated)
  description: Confirmed live 2026-09-21. _page_size=3 returns three categories; pagination.next_page carries a full cursor URL to page 2.

  request: {
    url: {{pim_base_url_v3}}/product-categories?_page_size=3
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "id": "6a38f5d8c3d65a5f868b182e",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Website Taxonomy",
              "path": ["Website Taxonomy"],
              "slug": "website-taxonomy",
              "order": 2,
              "n_children": 4,
              "created": "2026-06-22T08:44:08.293000",
              "modified": "2026-06-22T08:44:08.293000"
            },
            {
              "id": "6a38f5d8c3d65a5f868b182f",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Shopping Totes",
              "parent_id": "6a38f5d8c3d65a5f868b1830",
              "path": ["Google Shopping Taxonomy", "Luggage & Bags", "Shopping Totes"],
              "slug": "shopping-totes",
              "order": 1,
              "n_children": 0,
              "created": "2026-06-22T08:44:08.293000",
              "modified": "2026-06-22T08:44:08.293000"
            },
            {
              "id": "6a38f5d8c3d65a5f868b1832",
              "account_id": "6a38f5a5b22478f30bfd755c",
              "name": "Electronics",
              "parent_id": "6a38f5d8c3d65a5f868b1831",
              "path": ["Google Shopping Taxonomy", "Electronics"],
              "slug": "electronics",
              "order": 2,
              "n_children": 1,
              "created": "2026-06-22T08:44:08.293000",
              "modified": "2026-06-22T08:44:08.293000"
            }
          ],
          "errors": [],
          "pagination": {
            "next_page": "https://pim.dev.plytix.com/api/v3/product-categories?_page_size=3&_page=2"
          }
        }
      '''
    }
  }
}

example {
  name: 200 - Full Parameters
  description: Confirmed live 2026-09-22. Combines every confirmed-working query param at once for docs purposes -- multiple repeatable _fields, _page/_page_size, _sort_by, and a name[icontains] operator filter (same query-string filter dialect confirmed on /products, config/api-testing.config.md quirk #11).

  request: {
    url: {{pim_base_url_v3}}/product-categories?_fields=id&_fields=name&_fields=slug&_page=1&_page_size=2&_sort_by=name&name[icontains]=a
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "id": "6a38f5d8c3d65a5f868b1839",
              "name": "Apparel & Accessories",
              "slug": "apparel-accessories"
            },
            {
              "id": "6a38f5d8c3d65a5f868b185f",
              "name": "Apparel & Accessories",
              "slug": "apparel-accessories"
            }
          ],
          "errors": [],
          "pagination": {
            "next_page": "http://pim.dev.plytix.com/api/v3/product-categories?_fields=id&_fields=name&_fields=slug&_page=2&_page_size=2&_sort_by=name&name%5Bicontains%5D=a"
          }
        }
      '''
    }
  }
}
