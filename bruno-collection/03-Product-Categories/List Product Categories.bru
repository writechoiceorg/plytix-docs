meta {
  name: List Product Categories
  type: http
  seq: 2
}

get {
  url: {{pim_base_url_v3}}/product-categories?_fields=id&_fields=name&_page_size=3
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account".

  `GET /api/v3/product-categories` -- `_fields` and `_page_size` both work
  (same query-param behavior confirmed for `/products` in Phase 0).
  Account already has real pre-existing categories (e.g. "Electronics",
  "General Office Supplies", "Outerwear") -- read-only fixtures, not
  created by this test.
}
