meta {
  name: Get Access Token (Dev)
  type: http
  seq: 1
}

post {
  url: {{auth_base_url}}/auth/api/get-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "api_key": "{{process.env.PLYTIX_DEV_API_KEY}}",
    "api_password": "{{process.env.PLYTIX_DEV_API_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.data[0].access_token);
  }
}

assert {
  res.status: eq 200
  res.body.data[0].access_token: isString
}

docs {
  Same exchange as `02-Products-v3/Get Access Token (Dev).bru` -- repeated
  here so this folder is self-contained and can be run standalone with
  `bru run "03-Product-Categories/" --env "Dev"`.
}
