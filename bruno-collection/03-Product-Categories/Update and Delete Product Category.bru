meta {
  name: Update and Delete Product Category
  type: http
  seq: 5
}

delete {
  url: {{pim_base_url_v3}}/product-categories/REPLACE_WITH_CATEGORY_ID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

docs {
  Confirmed live 2026-09-15 against a fresh disposable scratch category
  ("WC Test Category For Patch Delete", id `6aa98187a30ca5945169a246`,
  created and destroyed in this same run) on "David's Dev Account" --
  retested from scratch as part of the 2026-09-15 spec refresh, since the
  original version of this file (named "... (Undeclared)") had no
  reachable resource and no `example{}` block. `openapi_pimv3.json`'s
  2026-09-15 refresh now formally declares `PATCH`/`DELETE` for
  `/product-categories/{identifier}` -- **historical note**: before this
  refresh, the spec declared neither method at all, and both were only
  known to work empirically (quirk #20 in `config/api-testing.config.md`).

  ## What it does
  - `PATCH /product-categories/{id}` with a partial body (`{"name": "..."}`)
    -- `200`, renames the category. Response shape matches the create
    response (missing `account_id`/`parent_id`; unlike `POST`'s response,
    `order` here comes back as a **string** `"6"` rather than a number --
    worth flagging as a minor type inconsistency, not previously noted.
  - `DELETE /product-categories/{id}` -- `204 No Content`, and a
    follow-up `GET` on the same id then returns `404`
    (`{"errors":[{"name":"NotFoundError","description":"Document with id
    ... not found"}]}`) -- genuinely deleted, not soft-deleted.

  This same undeclared-then-declared PATCH/DELETE pattern applies across
  nearly every v3 resource -- see `config/api-testing.config.md` quirk
  #20 and its 2026-09-15 update note for the running tally.
}

example {
  name: 200 - Success (PATCH)
  description: Real response captured 2026-09-15 against a disposable scratch category on "David's Dev Account".

  request: {
    url: {{pim_base_url_v3}}/product-categories/6aa98187a30ca5945169a246
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Category For Patch Delete Renamed"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6aa98187a30ca5945169a246",
            "modified": "2026-09-15T17:34:11.451775+00:00",
            "n_children": 0,
            "name": "WC Test Category For Patch Delete Renamed",
            "order": "6",
            "path": ["WC Test Category For Patch Delete Renamed"],
            "slug": "wc-test-category-for-patch-delete-renamed"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 200 - Full Parameters (Rename + Re-Parent)
  description: Confirmed live 2026-09-22 against two disposable scratch categories ("WC Test Full Params Category A/B", both deleted after capture). Exercises every field on ProductCategoryUpdateInputDto at once -- name AND parent_id together -- moving category B under category A in the same call. path reflects the new ancestry immediately; order still comes back as a string on PATCH (same quirk noted elsewhere).

  request: {
    url: {{pim_base_url_v3}}/product-categories/6ab2fa2a125f1d0ceeeed6b2
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Params Category B Renamed",
        "parent_id": "6ab2fa29125f1d0ceeeed6b1"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fa2a125f1d0ceeeed6b2",
            "modified": "2026-09-22T22:17:04.118456+00:00",
            "n_children": 0,
            "name": "WC Test Full Params Category B Renamed",
            "order": "1",
            "path": ["WC Test Full Params Category A", "WC Test Full Params Category B Renamed"],
            "slug": "wc-test-full-params-category-b-renamed",
            "parent_id": "6ab2fa29125f1d0ceeeed6b1"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 204 - Success
  description: Real response captured 2026-09-15 against the same disposable scratch category, immediately after the PATCH above.

  request: {
    url: {{pim_base_url_v3}}/product-categories/6aa98187a30ca5945169a246
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }
    headers: {
    }
    body: {
      type: json
      content: '''
        (empty body)
      '''
    }
  }
}

example {
  name: 404 - Not Found After Delete
  description: Real response captured 2026-09-15, follow-up GET on the same id immediately after the DELETE above, confirming a hard delete.

  request: {
    url: {{pim_base_url_v3}}/product-categories/6aa98187a30ca5945169a246
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "NotFoundError",
              "description": "Document with id 6aa98187a30ca5945169a246 not found"
            }
          ]
        }
      '''
    }
  }
}
