meta {
  name: Create Child Product Category
  type: http
  seq: 4
}

post {
  url: {{pim_base_url_v3}}/product-categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Child Category",
    "parent_id": "6a9f1b482b6fd055ffb7c7dc"
  }
}

assert {
  res.status: eq 201
  res.body.data.parent_id: eq 6a9f1b482b6fd055ffb7c7dc
  res.body.data.path: isArray
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account". **Fixture kept**
  -- id `6a9f1b542b6fd055ffb7c7dd`, child of "Create Product Category.bru"'s
  fixture.

  ## Nesting confirmed
  `path` reflects the full ancestry (`["WC Test Category", "WC Test Child
  Category"]`), and re-fetching the parent afterward shows `n_children`
  incremented from 0 to 1 -- see "Get Product Category by ID.bru".

  Not idempotent to re-run once the fixture exists -- same `422`
  duplicate-name behavior as "Create Product Category.bru".
}
