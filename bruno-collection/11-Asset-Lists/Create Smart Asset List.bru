meta {
  name: Create Asset List
  type: http
  seq: 2
}

post {
  url: {{pim_base_url_v3}}/asset-lists
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Asset Smart List",
    "type": "Smart",
    "query": [[{"operator": "eq", "field": "filename", "value": "wc_test_asset_renamed.jpg"}]]
  }
}

assert {
  res.status: eq 201
  res.body.data.type: eq Smart
}

docs {
  Confirmed live 2026-09-08. **Fixture kept** -- id
  `6aa032522b6fd055ffb7cabd`, for Ecatalogs (Phase 4) via
  `asset_list_id`.

  `201 Created`. Same shape and create-body dialect as
  `10-Pim-Product-Lists/Create Smart Product List.bru`. Filters on the
  Phase 2a kept asset's `filename`. A `type: "Static"` asset list works
  identically to Static product lists -- auto-generates a
  `static_lists`-contains-self query; real membership would be set via
  `PATCH /assets/{id}` with `static_list_ids` (not tested further here,
  since the Smart list already covers this folder's needed fixture for
  Phase 4 -- see `10-Pim-Product-Lists`'s docs for the full mechanism).

  Not idempotent to re-run once the fixture exists -- same `422`
  duplicate-name behavior as product lists (quirk #38a).

  ## GET by ID response shape (confirmed live 2026-09-21)
  Real fixture `6a38f612c3d65a5f868b19a0` ("All Assets", Static):
  `{"id":"6a38f612c3d65a5f868b19a0","account_id":"6a38f5a5b22478f30bfd755c",
  "name":"All Assets","query":[[{"operator":"in","field":"static_lists",
  "value":["6a38f612c3d65a5f868b19a0"],"field_type":null}]],
  "created":"2026-06-22T08:45:06.848000",
  "modified":"2026-06-22T08:45:06.866000","type":"Static"}`.

  ## Filter operator vocabulary note
  The list-`query` filter operator vocabulary (`like`/`!like`, `eq`/`!eq`,
  `in`/`!in`, `exists`/`!exists`, etc.) is **different** from the
  `icontains` operator confirmed in quirk #11/#53 for `GET /products`
  query params -- these are two different filter DSLs: one for a stored
  Smart-list `query` body, one for live `_fields`/filter query-string on
  search endpoints. Do not assume the same operator vocabulary applies
  to both.

  ## 422 -- missing required fields (absorbed from "Create Asset List - Missing Fields (422).bru")
  Confirmed live 2026-09-08. Empty body `{}` returns 422 with two
  entries in `errors` array (same shape as `10-Pim-Product-Lists`'s
  missing-fields 422 -- both `name` and `type` required).
}

example {
  name: 201 - Full Parameters (Multi-Group Query)
  description: Confirmed live 2026-09-22 against a disposable scratch Smart asset list (id 6ab2fe75125f1d0ceeeed6c1, deleted after capture). Same query expressiveness as product lists (outer array OR-ed, inner array AND-ed) -- this example combines two AND conditions in the first group with a second OR-ed group, across two operators (like, eq).

  request: {
    url: {{pim_base_url_v3}}/asset-lists
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Params Smart Asset List",
        "type": "Smart",
        "query": [
          [
            {"operator": "like", "field": "filename", "value": "wc_test"},
            {"operator": "eq", "field": "extension", "value": "jpg"}
          ],
          [
            {"operator": "eq", "field": "filename", "value": "wc_test_asset_renamed.jpg"}
          ]
        ]
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fe75125f1d0ceeeed6c1",
            "account_id": "6a38f5a5b22478f30bfd755c",
            "name": "WC Test Full Params Smart Asset List",
            "query": [
              [
                {"operator": "like", "field": "filename", "value": "wc_test", "field_type": null},
                {"operator": "eq", "field": "extension", "value": "jpg", "field_type": null}
              ],
              [
                {"operator": "eq", "field": "filename", "value": "wc_test_asset_renamed.jpg", "field_type": null}
              ]
            ],
            "created": "2026-09-22T22:17:25.493688+00:00",
            "modified": "2026-09-22T22:17:25.506896+00:00",
            "type": "Smart"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 422 - Missing Required Fields (name, type)
  description: Confirmed live 2026-09-08. Both name and type are required; empty body returns 422 with two errors entries.

  request: {
    url: {{pim_base_url_v3}}/asset-lists
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "InputDTOValidationError",
              "description": "name: Field required"
            },
            {
              "name": "InputDTOValidationError",
              "description": "type: Field required"
            }
          ]
        }
      '''
    }
  }
}
