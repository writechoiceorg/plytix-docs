meta {
  name: Get Product Attribute Group by ID
  type: http
  seq: 3
}

get {
  url: {{pim_base_url_v3}}/product-attribute-groups/6a9f1b872b6fd055ffb7c7df
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.name: eq WC Test Attribute Group
}

docs {
  `GET /api/v3/product-attribute-groups/{id}` -- fetch a single product
  attribute group by its Mongo ObjectId.

  Confirmed live 2026-09-07. Subpath discovery (`GET .../bogus_xyz`) reveals
  the raw field list: `['id','account_id','name','order','attribute_labels',
  'created','modified']` -- matches the spec's `ProductAttributeGroupOutputDto`
  exactly.
}

example {
  name: 200 - Success
  description: Confirmed live 2026-09-21. Full shape including attribute_labels array (contains label strings for member attributes).

  request: {
    url: {{pim_base_url_v3}}/product-attribute-groups/6a38f613c3d65a5f868b19af
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6a38f613c3d65a5f868b19af",
            "account_id": "6a38f5a5b22478f30bfd755c",
            "name": "Amazon",
            "order": 9,
            "attribute_labels": [
              "condition",
              "vendor",
              "asin_amazon_standard_identification_number",
              "english_features",
              "country_of_origin",
              "target_audience_1",
              "target_audience_2",
              "maximum_order_quantity",
              "amazon_product_title",
              "amazon_key_feature_3",
              "amazon_key_feature_2",
              "amazon_key_feature_1",
              "amazon_ready"
            ],
            "created": "2026-06-22T08:45:07.035000",
            "modified": "2026-06-22T08:45:07.035000"
          },
          "errors": []
        }
      '''
    }
  }
}
