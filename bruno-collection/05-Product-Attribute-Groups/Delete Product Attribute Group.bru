  request: {
    url: {{pim_base_url_v3}}/product-attribute-groups/6aa981b9a30ca5945169a248
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{access_token}}
      Accept: application/json
    }
  }

  response: {
