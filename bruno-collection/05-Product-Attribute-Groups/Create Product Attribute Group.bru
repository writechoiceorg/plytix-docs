meta {
  name: Create Product Attribute Group
  type: http
  seq: 2
}

post {
  url: {{pim_base_url_v3}}/product-attribute-groups
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Attribute Group"
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq WC Test Attribute Group
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account". **Fixture
  kept** -- id `6a9f1b872b6fd055ffb7c7df`, referenced by Product Attributes
  (`06-Product-Attributes`) via `group_ids`.

  `attribute_labels` defaults to `[]` when omitted (spec marks it
  optional). `201 Created`, consistent with every other Phase 1 resource.

  ## Not idempotent to re-run -- different status than categories
  Re-running once the fixture exists returns **`409 Conflict`**
  `{"errors":[{"name":"AlreadyExists","description":"A group with the
  same name already exists"}]}` -- note this is `409`/`AlreadyExists`,
  not the `422`/`ValidationError` categories use for the same kind of
  duplicate-name conflict (`config/api-testing.config.md` quirk #25a).
}
