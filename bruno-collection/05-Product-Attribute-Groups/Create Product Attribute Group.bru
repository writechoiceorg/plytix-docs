meta {
  name: Create Product Attribute Group
  type: http
  seq: 2
}

post {
  url: {{pim_base_url_v3}}/product-attribute-groups
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Attribute Group"
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq WC Test Attribute Group
}

docs {
  `POST /api/v3/product-attribute-groups` -- creates a product attribute group.

  Confirmed live 2026-09-07 against "David's Dev Account". **Fixture kept** --
  id `6a9f1b872b6fd055ffb7c7df`, referenced by Product Attributes
  (`06-Product-Attributes`) via `group_ids`.

  `attribute_labels` defaults to `[]` when omitted (spec marks it optional).
  `201 Created`, consistent with every other Phase 1 resource.

  ## Not idempotent -- different conflict status than categories
  Re-running once the fixture exists returns **`409 Conflict`**
  `{"errors":[{"name":"AlreadyExists","description":"A group with the same name
  already exists"}]}` -- note this is `409`/`AlreadyExists`, not the
  `422`/`ValidationError` that categories use for the same kind of
  duplicate-name conflict (`config/api-testing.config.md` quirk #25a).
}

example {
  name: 201 - Success
  description: Confirmed live 2026-09-07. Minimal body; attribute_labels defaults to empty array when omitted.

  request: {
    url: {{pim_base_url_v3}}/product-attribute-groups
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Attribute Group"
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6aa020272b6fd055ffb7ca98",
            "name": "WC Test Attribute Group",
            "order": 1,
            "attribute_labels": []
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 201 - Full Parameters
  description: Confirmed live 2026-09-22 (scratch group deleted after capture). Exercises every field on ProductAttributeGroupCreateInputDto at once -- name AND a populated attribute_labels array (real attribute labels from this account's "Amazon" group) -- unlike the minimal example above where attribute_labels defaults to [].

  request: {
    url: {{pim_base_url_v3}}/product-attribute-groups
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Full Params Attribute Group",
        "attribute_labels": ["condition", "vendor", "country_of_origin"]
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fe7c125f1d0ceeeed6c3",
            "name": "WC Test Full Params Attribute Group",
            "order": 12,
            "attribute_labels": ["condition", "vendor", "country_of_origin"]
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 409 - Duplicate Name
  description: Confirmed live 2026-09-07. Re-running after the fixture exists returns 409 AlreadyExists -- distinct from product categories which use 422 ValidationError for the same conflict.

  request: {
    url: {{pim_base_url_v3}}/product-attribute-groups
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Attribute Group"
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "AlreadyExists",
              "description": "A group with the same name already exists"
            }
          ]
        }
      '''
    }
  }
}
