meta {
  name: Create Import Profile
  type: http
  seq: 2
}

post {
  url: {{pim_base_url_v3}}/import-profiles
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "WC Test Import Profile"
  }
}

assert {
  res.status: eq 201
  res.body.data.settings.import_action: isString
}

docs {
  Confirmed live 2026-09-07 against "David's Dev Account". Created then
  deleted in the same test run (id was `6a9f1d492b6fd055ffb7c805`) --
  Import Profiles has no downstream dependents in `TESTING_PLAN.md`.

  `201 Created`. `settings` (spec-optional, undocumented sub-shape) gets a
  full set of real defaults applied even when omitted entirely:
  `{"import_action":"ALL","import_assets_action":"SKIP",
  "import_decimal_separator":".","new_products_status":"Draft",
  "charset":null,"column_separator":null,"text_delimiter":null,
  "create_static_list":false,"family_options":null,"column_matches":[]}`
  -- this is now the confirmed live shape of `ProfileSettingsInputDto`'s
  defaults, previously undiscovered.

  ## Partial settings are merged with defaults
  Confirmed live 2026-09-07 (absorbed from "Create Import Profile - With
  Settings.bru"): sending only 3 fields in `settings` (e.g.
  `import_action`, `charset`, `column_separator`) causes the remaining
  fields (`import_assets_action`, `new_products_status`, etc.) to still
  receive their normal defaults. Full `settings` is always returned on the
  response regardless of what was sent.

  ## GET by ID response shape (confirmed live 2026-09-21)
  Real fixture `6aa98678a30ca5945169a25c` ("WC Test Import Profile"):
  `{"id":"6aa98678a30ca5945169a25c","account_id":"6a38f5a5b22478f30bfd755c",
  "name":"WC Test Import Profile","settings":{"import_action":"ALL",
  "import_assets_action":"SKIP","import_decimal_separator":".",
  "new_products_status":"Draft","charset":null,"column_separator":null,
  "text_delimiter":null,"create_static_list":false,"family_options":null,
  "column_matches":[]},"created":null,"modified":"2026-09-15T17:55:04.587000"}`.
  Note `created` is null for older fixtures -- not a bug, just sparse audit
  data on pre-existing records.

  ## 422 -- missing name (absorbed from "Create Import Profile - Missing Name (422).bru")
  Confirmed live 2026-09-07. Empty body `{}` returns 422. Same 422
  envelope shape confirmed across every resource this session.
}

example {
  name: 201 - Partial Settings (Defaults Merged)
  description: Confirmed live 2026-09-07. Partial settings object is merged with defaults; only sent fields are overridden.

  request: {
    url: {{pim_base_url_v3}}/import-profiles
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Import Profile Full",
        "settings": {
          "import_action": "NEW",
          "charset": "UTF-8",
          "column_separator": ","
        }
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "name": "WC Test Import Profile Full",
            "settings": {
              "import_action": "NEW",
              "import_assets_action": "SKIP",
              "import_decimal_separator": ".",
              "new_products_status": "Draft",
              "charset": "UTF-8",
              "column_separator": ",",
              "text_delimiter": null,
              "create_static_list": false,
              "family_options": null,
              "column_matches": []
            }
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 201 - Full Parameters
  description: Confirmed live 2026-09-22. Every ProfileSettingsCreateInputDto field populated at once, including nested family_options and a column_matches entry. Created then deleted in the same run (scratch id 6ab2fa16125f1d0ceeeed6a8) — no downstream dependents. Note column_matches entries round-trip with formatters:[] and relationship:null defaulted in even though not sent.

  request: {
    url: {{pim_base_url_v3}}/import-profiles
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {
        "name": "WC Test Import Profile Full Params",
        "settings": {
          "import_action": "UPDATE",
          "import_assets_action": "ALL",
          "import_decimal_separator": ",",
          "new_products_status": "Draft",
          "charset": "UTF-8",
          "column_separator": ";",
          "text_delimiter": "\"",
          "create_static_list": true,
          "family_options": {
            "out_of_the_family_attributes": "UPDATE",
            "overwritten_attributes": "OVERWRITE"
          },
          "column_matches": [
            {
              "attr_label": "SKU",
              "column_label": "sku",
              "empty_values": "SKIP",
              "new_values": "CREATE"
            }
          ]
        }
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "6ab2fa16125f1d0ceeeed6a8",
            "name": "WC Test Import Profile Full Params",
            "settings": {
              "import_action": "UPDATE",
              "import_assets_action": "ALL",
              "import_decimal_separator": ",",
              "new_products_status": "Draft",
              "charset": "UTF-8",
              "column_separator": ";",
              "text_delimiter": "\"",
              "create_static_list": true,
              "family_options": {
                "out_of_the_family_attributes": "UPDATE",
                "overwritten_attributes": "OVERWRITE"
              },
              "column_matches": [
                {
                  "attr_label": "SKU",
                  "column_label": "sku",
                  "empty_values": "SKIP",
                  "new_values": "CREATE",
                  "formatters": [],
                  "relationship": null
                }
              ]
            },
            "modified": "2026-09-22T21:58:46.314395+00:00"
          },
          "errors": []
        }
      '''
    }
  }
}

example {
  name: 422 - Missing Required Field (name)
  description: Confirmed live 2026-09-07. Empty body triggers 422; name is required.

  request: {
    url: {{pim_base_url_v3}}/import-profiles
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{access_token}}
      Content-Type: application/json
      Accept: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    headers: {
      content-type: application/json; charset=utf-8
    }
    body: {
      type: json
      content: '''
        {
          "data": [],
          "errors": [
            {
              "name": "InputDTOValidationError",
              "description": "name: Field required"
            }
          ]
        }
      '''
    }
  }
}
